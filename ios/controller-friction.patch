+
+// The counters use guest frame-loop iterations, which can differ from rendered frames.
+
+// Steam t6mp: use the same local-player flags as the enemy-crosshair HUD.
+// Read on the guest's input thread. The launcher enables this only for local practice.
+static bool localEnemyCrosshair() {
+    if (win32_mem_read32(0x10e9d88) != 10) return false;
+    uint32_t server = win32_mem_read32(0x24849c8);
+    if (!server || server > UINT32_MAX - 32 || win32_mem_read32(server + 0x10) != 1 ||
+        !(win32_mem_read32(server + 0x18) & 0xff)) return false;
+    uint32_t cg = win32_mem_read32(0x10616cc);
+    if (!cg || cg > UINT32_MAX - 0x695d0) return false;
+    uint32_t flags = win32_mem_read32(cg + 0x480b8);
+    return (flags & 0x18) == 0x10 &&
+           win32_mem_read32(cg + 0x4808c) - win32_mem_read32(cg + 0x695cc) < 150;
+}
+
+static void slowRightStick(Gamepad& pad) {
+    // Retain the XInput dead-zone boundary, the direction, and zero input.
+    double radius = std::hypot(double(pad.rx), double(pad.ry));
+    constexpr double deadZone = 8689;
+    if (radius <= deadZone) return;
+    double gain = (deadZone + (radius - deadZone) * 0.55) / radius;
+    pad.rx = int16_t(std::lround(pad.rx * gain));
+    pad.ry = int16_t(std::lround(pad.ry * gain));
+}
