+#if defined(BO2_TARGET_ZMS)
+static constexpr uint32_t clientState = 0x10e7e18, clientGame = 0x105f75c, entityArray = 0x1060e48;
+static constexpr uint32_t targetLimit = 1022, targetType = 0x10, scriptDisable = 0xf8640c;
+#else
+static constexpr uint32_t clientState = 0x10e9d88, clientGame = 0x10616cc, entityArray = 0x1062db8;
+static constexpr uint32_t targetLimit = 18, targetType = 1, scriptDisable = 0xf8838c;
+#endif
+static bool assistAllowedInMatch() {
+    if (win32_mem_read32(clientState) != 10) return false;
+    uint32_t setting = win32_mem_read32(scriptDisable);
+    return setting && setting <= UINT32_MAX - 28 && win32_mem_read32(setting + 0x10) == 1 &&
+           !(win32_mem_read32(setting + 0x18) & 255);
+}
+static std::atomic<bool> localController{false};
+static std::atomic<uint64_t> selected{0};
+extern "C" uint8_t bo2_local_lockon(uint8_t original) {
+    selected.store(0, std::memory_order_relaxed);
+    return localController.load(std::memory_order_relaxed) ? 1 : original;
+}
+extern "C" float bo2_lock_range(float weaponRange) {
+    return localController.load(std::memory_order_relaxed) ? weaponRange * 1.35f : weaponRange;
+}
+extern "C" void bo2_selected_target(uint32_t id) {
+    if (id < targetLimit && localController.load(std::memory_order_relaxed))
+        selected.store(((bo2_pace_clock() / 1000000) << 16) | (id + 1), std::memory_order_relaxed);
+}
+
+static bool pullRightStick(Gamepad& pad) {
+    uint32_t cg = win32_mem_read32(clientGame);
+    if (!cg || cg > UINT32_MAX - 0x695d0) return false;
+    uint32_t flags = win32_mem_read32(cg + 0x480b8);
+    uint32_t age = win32_mem_read32(cg + 0x4808c) - win32_mem_read32(cg + 0x695cc);
+    uint32_t id = win32_mem_read32(cg + 0x695c8);
+    static uint32_t confirmed = UINT32_MAX, traceTime = 0, lastCg = 0;
+    uint32_t now = win32_mem_read32(cg + 0x4808c);
+    if (lastCg != cg || (flags & 8) || age > 400) confirmed = UINT32_MAX;
+    lastCg = cg;
+    if ((flags & 0x18) == 0x10 && age < 150 && id < targetLimit) {
+        confirmed = id;
+        traceTime = now - age;
+    }
+    if (flags & 8) return false;
+    uint64_t native = selected.load(std::memory_order_relaxed);
+    bool fromNative = native && bo2_pace_clock()/1000000 - (native >> 16) < 100;
+    if (fromNative)
+        id = uint32_t(native & 65535) - 1;
+    else if (id >= targetLimit || id != confirmed || now - traceTime > 400) return false;
+    uint32_t entities = win32_mem_read32(entityArray);
+    if (!entities || entities > UINT32_MAX - targetLimit * 0x380) return false;
+    uint32_t ent = entities + id * 0x380;
+    if ((win32_mem_read32(ent + 0x2b4) & 0xffff) != targetType ||
+        !(win32_mem_read32(ent + 0x378) & 2)) return false;
+    double delta[3], view[3] = {};
+    for (int i = 0; i < 3; ++i)
+        delta[i] = guestFloat(ent + 0x2c + 4*i) - guestFloat(cg + 0x4d8c4 + 4*i);
+    delta[2] += 42; // Standing upper torso.
+    for (int axis = 0; axis < 3; ++axis)
+        for (int i = 0; i < 3; ++i)
+            view[axis] += delta[i] * guestFloat(cg + 0x4d8d4 + 12*axis + 4*i);
+    if (!(view[0] > 1)) return false;
+    double x = -view[1] / view[0], y = view[2] / view[0];
+    double distance = std::hypot(x, y);
+    double hand = std::hypot(double(pad.rx), double(pad.ry));
+    if (!std::isfinite(distance) || distance > 0.19 || hand >= 32767) return false;
+    static uint64_t lastRangeLog = 0;
+    uint64_t sampleTime = bo2_pace_clock()/1000000;
+    if (sampleTime - lastRangeLog >= 200) {
+        fprintf(stderr, "[assist-range] %llu %d %.1f %.5f\n",
+                (unsigned long long)sampleTime, int(fromNative), view[0], distance);
+        lastRangeLog = sampleTime;
+    }
+    double gain = hand <= 8689 ? 1.0 : (8689 + (hand - 8689)*0.30) / hand;
+    // Ease back to unmodified input as the player deliberately turns away.
+    double blend = std::fmin(1.0, (32767 - hand) / 8000.);
+    gain = 1.0 + (gain - 1.0) * blend;
+    double dx = 0, dy = 0;
+    // Keep the quiet zone within roughly three world units at long range.
+    if (distance > std::fmax(0.001, std::fmin(0.005, 3.0/view[0]))) {
+        double pull = (9800 + 9800 * std::fmin(distance / 0.08, 1.0)) *
+                      blend * (pad.lt > 30 ? 1.0 : 0.72);
+        dx = x * pull / distance;
+        dy = y * pull / distance;
+    }
+    auto axisValue = [](double v) { return int16_t(std::lround(std::fmax(-32768, std::fmin(32767, v)))); };
+    pad.rx = axisValue(pad.rx * gain + dx);
+    pad.ry = axisValue(pad.ry * gain + dy);
+    return true;
+}
