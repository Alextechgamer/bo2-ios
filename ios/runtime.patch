+// Decode D3D compressed images before allocating iOS Metal textures.
+static bool ios_native_bc = false;
+static bool ios_expand_texture(TexStage& t) {
+    std::vector<uint8_t> output, pixels, packed;
+    std::vector<uint32_t> offsets, pitches;
+    const unsigned slices = std::max(t.depth, t.faces);
+    for (unsigned slice = 0; slice < slices; ++slice) {
+        for (unsigned mip = 0; mip < t.mips; ++mip) {
+            const unsigned i = slice * t.mips + mip;
+            const unsigned w = std::max(1u, t.w >> mip), h = std::max(1u, t.h >> mip);
+            const unsigned rows = (h + 3) / 4;
+            const unsigned row = ((w + 3) / 4) * ((t.fmt <= 72 || t.fmt == 80 || t.fmt == 81) ? 8 : 16);
+            const size_t pitch = t.mip_pitch.empty() ? t.pitch : t.mip_pitch.at(i);
+            const size_t offset = t.mip_off.empty() ? slice * (t.slice_pitch ? t.slice_pitch : pitch * rows) : t.mip_off.at(i);
+            if (pitch < row || offset + (rows - 1) * pitch + row > t.bytes.size()) return false;
+            packed.resize(size_t(rows) * row);
+            for (unsigned y = 0; y < rows; ++y)
+                memcpy(packed.data() + size_t(y)*row, t.bytes.data() + offset + y*pitch, row);
+            if (!bo2_bc_decode(t.fmt, packed.data(), packed.size(), w, h, pixels)) return false;
+            offsets.push_back(output.size()); pitches.push_back(w*4);
+            output.insert(output.end(), pixels.begin(), pixels.end());
+        }
+    }
+    t.bytes.swap(output); t.mip_off.swap(offsets); t.mip_pitch.swap(pitches);
+    t.fmt = 28; t.pitch = t.w*4; t.slice_pitch = t.pitch*t.h;
+    return true;
+}
