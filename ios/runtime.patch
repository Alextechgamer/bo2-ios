+struct IOSShaderBatch {
+    std::vector<ShaderStage> shaders;
+    std::vector<id<MTLFunction>> functions;
+    std::vector<std::string> errors;
+};
+static void ios_compile_batch(IOSShaderBatch& batch) {
+    static id<MTLLibrary> bundled = [] {
+        NSURL* url = [NSBundle.mainBundle URLForResource:@"BO2Shaders" withExtension:@"metallib"];
+        return url ? [g_device newLibraryWithURL:url error:nil] : nil;
+    }();
+    const size_t n=batch.shaders.size();
+    batch.functions.resize(n); batch.errors.resize(n);
+    std::vector<size_t> missing;
+    std::vector<const std::string*> sources;
+    for (size_t i=0; i<n; ++i) {
+        auto& source=batch.shaders[i].msl;
+        auto hash=msl_fnv64(source);
+        NSString* name=[NSString stringWithFormat:@"bo2_%016llx", (unsigned long long)hash];
+        if (bundled) batch.functions[i]=[bundled newFunctionWithName:name];
+        if (batch.functions[i]) { ++g_msl_from_cache; continue; }
+        if (bo2_env_on("BO2_CAPTURE_MSL")) {
+            NSURL* dir=[[[NSFileManager defaultManager] URLsForDirectory:NSCachesDirectory inDomains:NSUserDomainMask].firstObject URLByAppendingPathComponent:@"BO2ShaderSources"];
+            [[NSFileManager defaultManager] createDirectoryAtURL:dir withIntermediateDirectories:YES attributes:nil error:nil];
+            NSString* leaf=[NSString stringWithFormat:@"%016llx.msl",(unsigned long long)hash];
+            [@(source.c_str()) writeToURL:[dir URLByAppendingPathComponent:leaf] atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        }
+        missing.push_back(i); sources.push_back(&source);
+    }
+    if (!missing.empty()) {
+        std::vector<id<MTLFunction>> out(missing.size());
+        std::vector<std::string> errors(missing.size());
+        msl_compile(sources.data(),sources.size(),out.data(),errors.data());
+        for (size_t j=0; j<missing.size(); ++j) {
+            batch.functions[missing[j]]=out[j]; batch.errors[missing[j]]=std::move(errors[j]);
+        }
+    }
+}
