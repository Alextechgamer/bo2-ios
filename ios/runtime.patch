+static void collect_pipelines() {
+    std::vector<IOSPipelineResult> done;
+    { std::lock_guard<std::mutex> lock(pipelineResultLock); done.swap(completedPipelines); }
+    for (const auto& result : done) {
+        pendingPipelines.erase(result.key);
+        if (result.pipeline) {
+            g_pipe_cache[result.key] = result.pipeline;
+            ++g_pipe_built;
+        } else {
+            ++g_pipe_failed;
+            if ([result.error.localizedDescription localizedCaseInsensitiveContainsString:@"interrupted"])
+                retryPipelineAfter[result.key] = CACurrentMediaTime()+1;
+            else g_pipe_cache[result.key] = nil;
+            if (g_pipe_failed<=5) NSLog(@"BO2 pipeline: %@", result.error.localizedDescription);
+        }
+    }
+}
